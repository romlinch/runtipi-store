{
  "services": [
    {
      "name": "llama-cpp",
      "image": "ghcr.io/ggml-org/llama.cpp:server-cuda",
      "isMain": true,
      "internalPort": "8080",
      "addToMainNetwork": true,
      "environment": {
        "LLAMA_LOG_VERBOSITY": "1",
        "GGML_CUDA_ENABLE_UNIFIED_MEMORY": "1"
      },
      "volumes": [
        {
          "hostPath": "${LLAMA_MODELS_DIR}",
          "containerPath": "/models",
          "readOnly": true
        },
        {
          "hostPath": "${APP_DATA_DIR}/config",
          "containerPath": "/config",
          "readOnly": true
        },
        {
          "hostPath": "${APP_DATA_DIR}/slot-cache",
          "containerPath": "/slot-cache"
        }
      ],
      "addPorts": [
        {
          "containerPort": "8080",
          "hostPort": "8085"
        }
      ],
      "command": [
        "--model",
        "/models/gemma4-26b/gemma-4-26B-A4B-it-UD-Q4_K_M.gguf",
        "--alias",
        "gemma4-26b-a4b",
        "--host",
        "0.0.0.0",
        "--port",
        "8080",
        "--ctx-size",
        "131072",
        "--n-gpu-layers",
        "99",
        "--n-cpu-moe",
        "99",
        "--flash-attn",
        "--cache-type-k",
        "q8_0",
        "--cache-type-v",
        "q8_0",
        "--jinja",
        "--threads",
        "8",
        "--parallel",
        "2",
        "--cont-batching",
        "--cache-reuse",
        "256",
        "--cache-idle-slots",
        "--slot-save-path",
        "/slot-cache",
        "--no-context-shift",
        "--metrics",
        "--temp",
        "1.0",
        "--top-p",
        "0.95",
        "--top-k",
        "64",
        "--min-p",
        "0.01",
        "--repeat-penalty",
        "1.0",
        "--chat-template-kwargs",
        "{\"enable_thinking\":false}",
        "--sleep-idle-seconds",
        "-1"
      ],
      "deploy": {
        "resources": {
          "reservations": {
            "devices": [
              {
                "capabilities": ["gpu"],
                "driver": "nvidia",
                "count": 1
              }
            ]
          }
        }
      }
    }
  ]
}

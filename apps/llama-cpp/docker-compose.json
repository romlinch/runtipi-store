{
  "services": [
    {
      "name": "llama-cpp",
      "image": "ghcr.io/ggml-org/llama.cpp:server-cuda",
      "isMain": true,
      "internalPort": "8080",
      "addToMainNetwork": true,
      "environment": {
        "LLAMA_LOG_VERBOSITY": "3"
      },
      "volumes": [
        {
          "hostPath": "${LLAMA_MODELS_DIR}",
          "containerPath": "/models",
          "readOnly": true
        },
        {
          "hostPath": "${APP_DATA_DIR}/config",
          "containerPath": "/config",
          "readOnly": true
        },
        {
          "hostPath": "${APP_DATA_DIR}/slot-cache",
          "containerPath": "/slot-cache"
        }
      ],
      "addPorts": [
        {
          "containerPort": "8080",
          "hostPort": "8085"
        }
      ],
      "command": [
        "--model",
        "/models/gemma4/gemma-4-E4B-it-Q4_K_M.gguf",
        "--mmproj",
        "/models/gemma4/mmproj-F16.gguf",
        "--no-mmproj-offload",
        "--alias",
        "gemma4-e4b",
        "--host",
        "0.0.0.0",
        "--port",
        "8080",
        "--ctx-size",
        "65536",
        "--parallel",
        "1",
        "--n-gpu-layers",
        "99",
        "--flash-attn",
        "auto",
        "--cache-type-k",
        "q8_0",
        "--cache-type-v",
        "q8_0",
        "--batch-size",
        "2048",
        "--ubatch-size",
        "1024",
        "--threads",
        "8",
        "--threads-batch",
        "8",
        "--cache-ram",
        "20480",
        "--slot-save-path",
        "/slot-cache",
        "--cache-idle-slots",
        "--jinja",
        "--cont-batching",
        "--no-context-shift",
        "--metrics",
        "--slots",
        "--kv-unified",
        "--temp",
        "1.0",
        "--top-p",
        "0.95",
        "--top-k",
        "64",
        "--min-p",
        "0.01",
        "--repeat-penalty",
        "1.0"
      ],
      "deploy": {
        "resources": {
          "reservations": {
            "devices": [
              {
                "capabilities": ["gpu"],
                "driver": "nvidia",
                "count": 1
              }
            ]
          }
        }
      }
    }
  ]
}

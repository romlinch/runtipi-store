{
  "services": [
    {
      "name": "pi-pocket",
      "image": "node:24-bookworm",
      "isMain": true,
      "internalPort": "8787",
      "entrypoint": ["sh", "/start.sh"],
      "shmSize": "1gb",
      "stopGracePeriod": "30s",
      "environment": {
        "PI_POCKET_TAG": "v0.19.0",
        "PI_POCKET_APT": "${PI_POCKET_APT}",
        "PI_POCKET_BROWSER_ARGS": "--no-sandbox",
        "TZ": "${TZ}"
      },
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data/start.sh",
          "containerPath": "/start.sh",
          "readOnly": true
        },
        {
          "hostPath": "${APP_DATA_DIR}/data/home",
          "containerPath": "/home/node"
        },
        {
          "hostPath": "${APP_DATA_DIR}/data/workspace",
          "containerPath": "/workspace"
        }
      ]
    }
  ]
}

{
  "services": [
    {
      "name": "rssmonster",
      "image": "rssmonster/rssmonster:sha-e6ad401",
      "isMain": true,
      "internalPort": 3000,
      "environment": {
        "NODE_ENV": "production",
        "PORT": "3000",
        "DB_DIALECT": "sqlite",
        "DB_STORAGE": "/app/data/rssmonster.sqlite",
        "JWT_SECRET": "${RSSMONSTER_JWT_SECRET}",
        "FEVER_CREDENTIAL_SECRET": "${RSSMONSTER_FEVER_CREDENTIAL_SECRET}",
        "ALLOW_REGISTRATION": "${RSSMONSTER_ALLOW_REGISTRATION}",
        "TRUST_PROXY": "1",
        "CRAWL_WORKER_HEALTH_FILE": "/app/worker-health/crawl-worker-health.json",
        "TZ": "${TZ}"
      },
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data",
          "containerPath": "/app/data"
        },
        {
          "hostPath": "${APP_DATA_DIR}/worker-health",
          "containerPath": "/app/worker-health",
          "readOnly": true
        }
      ],
      "healthCheck": {
        "test": "node -e \"fetch('http://127.0.0.1:3000/api/health').then(r => process.exit(r.ok ? 0 : 1)).catch(() => process.exit(1))\"",
        "interval": "30s",
        "timeout": "5s",
        "retries": 5,
        "startPeriod": "60s"
      }
    },
    {
      "name": "rssmonster-worker",
      "image": "rssmonster/rssmonster:sha-e6ad401",
      "command": ["npm", "run", "start:worker"],
      "environment": {
        "NODE_ENV": "production",
        "DB_DIALECT": "sqlite",
        "DB_STORAGE": "/app/data/rssmonster.sqlite",
        "JWT_SECRET": "${RSSMONSTER_JWT_SECRET}",
        "FEVER_CREDENTIAL_SECRET": "${RSSMONSTER_FEVER_CREDENTIAL_SECRET}",
        "CRAWL_WORKER_HEALTH_FILE": "/app/worker-health/crawl-worker-health.json",
        "TZ": "${TZ}"
      },
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data",
          "containerPath": "/app/data"
        },
        {
          "hostPath": "${APP_DATA_DIR}/worker-health",
          "containerPath": "/app/worker-health"
        }
      ],
      "dependsOn": ["rssmonster"],
      "healthCheck": {
        "test": "node src/workers/checkCrawlWorkerHealth.js",
        "interval": "30s",
        "timeout": "5s",
        "retries": 3,
        "startPeriod": "2m"
      }
    }
  ]
}

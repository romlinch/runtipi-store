{
  "services": [
    {
      "name": "music-assistant",
      "image": "ghcr.io/music-assistant/server:2.10.8",
      "isMain": true,
      "internalPort": "8095",
      "networkMode": "host",
      "environment": {
        "LOG_LEVEL": "info"
      },
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data",
          "containerPath": "/data"
        }
      ]
    }
  ]
}
